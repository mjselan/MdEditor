/* ==========================================================================
   Shared installer stylesheet — keep the three platform copies in sync:
   Installer/Windows/config/style.qss (canonical),
   Installer/MacOS/config/style.qss (this file),
   Installer/Linux/config/style.qss.
   NOTE: only the --ifw installer format loads this file; the default
   native drag-and-drop DMG does not use an IFW wizard.
   ========================================================================== */

/* ==========================================================================
   1. Base Text & Labels
   Fixes white-on-white text caused by OS Dark Theme on white wizard pages
   ========================================================================== */

/* All standard descriptive text (Welcome body, license label, etc.) */
QLabel {
    color: #222222;
}

/* Keep the main page headers blue (Welcome, License Agreement, etc.) */
QLabel#titleLabel,
QLabel#headerLabel {
    color: #1a5fb4;
    font-size: 16px;
    font-weight: bold;
}

/* ==========================================================================
   2. Checkboxes & Radio Buttons
   ========================================================================== */

/* The license acceptance checkbox and label text */
QCheckBox {
    color: #222222;
    spacing: 8px;
    font-size: 13px;
}

QCheckBox:disabled {
    color: #888888;
}


/* Radio buttons (used on dynamic and finished pages) */
QRadioButton {
    color: #222222;
    spacing: 8px;
}

/* ==========================================================================
   3. Path Input Fields (Folder Selection & Start Menu)
   ========================================================================== */

QLineEdit {
    background-color: #ffffff;
    color: #222222;
    border: 1px solid #c8b99c;
    border-radius: 3px;
    padding: 4px 6px;
}

QLineEdit:focus {
    border: 1px solid #dfd1b8;
}

/* ==========================================================================
   4. License Code Viewer (Keeps the clean dark box with white monospace text)
   ========================================================================== */

QTextEdit, QTextBrowser {
    background-color: #242424;
    color: #ffffff;
    border: 1px solid #444444;
    border-radius: 4px;
}

/* ==========================================================================
   5. Buttons (Option A - Verified Working)
   ========================================================================== */

QPushButton {
    background-color: #333333;
    color: #ffffff;
    border: 1px solid #c8b99c;
    border-radius: 4px;
    padding: 5px 18px;
    min-width: 65px;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #4a4a4a;
    color: #ffffff;
    border: 1px solid #dfd1b8;
}

QPushButton:pressed {
    background-color: #222222;
    color: #ffffff;
}

QPushButton:disabled {
    background-color: #e5e5e5;
    color: #999999;
    border: 1px solid #cccccc;
}

/* ==========================================================================
   Popup Dialogs (Existing Installation prompt, alerts, questions)
   ========================================================================== */

QMessageBox {
    background-color: #242424;
}

QMessageBox QLabel {
    color: #ffffff;          /* Crisp white text on dark dialog background */
    font-size: 13px;
}
