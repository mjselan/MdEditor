# Build trees (CMake presets use build/debug, build/release)
build/
out/
cmake-build-*/

# CMake generated
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
_deps/

# Ninja
.ninja_deps
.ninja_log

# Qt generated (AUTOMOC/UIC/RCC outputs live in build/, but cover strays)
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qmake.stash
*.pro.user*

# MSVC / Visual Studio
.vs/
*.VC.db
*.VC.VC.opendb
*.user
*.sln
*.vcxproj*
Debug/
Release/
x64/
.VSCodeCounter/

# Compiled output
*.exe
*.dll
*.lib
*.a
*.so
*.dylib
*.o
*.obj
*.pdb
*.ilk
*.exp

# Qt Creator / CLion
*.creator.user*
.idea/
cmake-build*/
.creator/

# OS / editor
Thumbs.db
Desktop.ini
.DS_Store
*~
*.swp
*.orig
*.rej

# Local temp / scratch
tmp/

# Generated application icons (regenerate via the app_icon target)
resources/app.ico
resources/*.icns

# Qt IFW installer: keep config/meta sources; ignore platform payloads + outputs
dist/
Installer/Windows/packages/*/data/
Installer/MacOS/packages/*/data/
Installer/Linux/packages/*/data/
Installer/Windows/*.exe
Installer/MacOS/*.dmg
Installer/MacOS/*.app
Installer/Linux/*.run
InstallationLog.txt
