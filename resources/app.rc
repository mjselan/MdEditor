// Windows shell resources for markdowneditor.exe.
// resources/app.ico is generated by the makeico tool (see CMakeLists.txt).
IDI_ICON1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "MdEditor"
            VALUE "FileDescription",  "Markdown Editor"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "markdowneditor"
            VALUE "OriginalFilename", "markdowneditor.exe"
            VALUE "ProductName",      "Markdown Editor"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
