{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{QT_DIR}",
                "CMAKE_BUILD_TYPE": "$env{BUILD_TYPE}"
            }
        },
        {
            "name": "debug",
            "inherits": "base",
            "environment": { "BUILD_TYPE": "Debug" },
            "cacheVariables": { "BUILD_TESTING": "ON" }
        },
        {
            "name": "release",
            "inherits": "base",
            "environment": { "BUILD_TYPE": "Release" },
            "cacheVariables": { "BUILD_TESTING": "OFF" }
        },
        {
            "name": "macos-universal",
            "inherits": "base",
            "environment": { "BUILD_TYPE": "Release" },
            "cacheVariables": {
                "BUILD_TESTING": "OFF",
                "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0"
            }
        }
    ],
    "buildPresets": [
        { "name": "debug", "configurePreset": "debug" },
        { "name": "release", "configurePreset": "release" },
        { "name": "macos-universal", "configurePreset": "macos-universal" }
    ],
    "testPresets": [
        { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } }
    ]
}
